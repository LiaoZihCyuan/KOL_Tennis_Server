  "cards": [
    { "dot": "rose", "title": "兩道 hook 不靠 AI 自律", "items": [
      "Stop hook：app 檔案有未驗證的改動，就擋下收工一次",
      "guard hook：刪資料表、刪 volume、刪備份一律拒絕；部署與寫入 SQL 強制問人" ] },
    { "dot": "amber", "title": "驗證的人不是寫的人", "items": [
      "verifier 自己讀 diff、開瀏覽器操作，只有它能記錄 PASS",
      "PASS 之後再改任何 app 檔案，指紋改變，PASS 失效" ] },
    { "dot": "cyan", "title": "正式站只看不改", "items": [
      "部署第一步先備份，備份檔空的或壞的就中止",
      "上線後的檢查擋掉所有非 GET 請求，需要寫入的項目以本機為準" ] }
